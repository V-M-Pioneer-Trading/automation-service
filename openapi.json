                }
              }
            }
          }
        },
        "description": "Asks the fleet scheduler to replan now. Served only when the service has a fleet scheduler (mining configured).",
        "tags": [
          "planner"
        ],
        "security": [
          {
            "clerk": [
              "planner:advise"
            ]
          }
        ],
        "parameters": [],
        "x-auth": "planner:advise"
      }
    },
