    "/api/automation/v1/events": {
      "post": {
        "operationId": "AppendEvent",
        "responses": {
          "201": {
            "description": "Appended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkAnswer"
                }
              }
            }
          },
          "400": {
            "description": "type must be a string starting with \"ai_\"; detail must be an object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "description": "Appends an `ai_` audit event. `detail.actor` is stamped with the verified\n`sub` and overrides anything the caller put there: the audit trail says who\nwrote a row because the center said so, not because the row said so.",
        "tags": [
          "events"
        ],
        "security": [
          {
            "clerk": [
              "events:write"
            ]
          }
        ],
        "parameters": [],
        "x-auth": "events:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "pattern": "^ai_",
                    "description": "Must start with \"ai_\"."
                  },
                  "detail": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Free-form object. detail.actor is overwritten with the caller's verified sub."
                  }
                }
              }
            }
          }
        }
      }
    },
