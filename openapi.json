    "securitySchemes": {
      "clerk": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Clerk session or machine token, verified by auth-service (never here). The scope in a security requirement is the one the token's introspected scope must contain. OpenAPI 3.0 asks for an empty array on a non-oauth2 scheme; scopes are listed anyway so a reader sees what each route needs, and tsoa emits no 3.1 yet."
      }
    }
  },
  "info": {
    "title": "Automation Service API",
    "version": "1.0.0",
    "description": "The SpaceTraders fleet autopilot. Every route of the service is listed; x-auth names what each requires of a caller (public, or a scope) and security repeats it as an OpenAPI requirement.",
    "contact": {}
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/automation/v1/planner/knobs": {
      "get": {
        "operationId": "ListKnobs",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnobsAnswer"
                }
              }
            }
          },
          "400": {
            "description": "class must be \"model\", \"policy\" or \"alert\"",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "description": "The tunable knobs. `?class=policy` is how the AI supervisor asks for exactly\nthe knobs it is allowed to write. Serving the filter here rather than\ntrusting the caller to filter means the restriction holds even if a client\nforgets it.",
        "tags": [
          "planner"
        ],
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "class",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-auth": "public"
      }
    },
    "/api/automation/v1/planner/model": {
      "get": {
        "operationId": "PlannerModel",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelAnswer"
                }
              }
            }
          }
        },
        "description": "What the planner currently believes about the universe, and whether each\nbelief was measured or assumed. The single most useful thing to look at\nwhen a ship goes somewhere surprising.",
        "tags": [
          "planner"
        ],
        "security": [],
        "parameters": [],
        "x-auth": "public"
      }
    },
    "/api/automation/v1/planner/replan": {
      "post": {
        "operationId": "Replan",
        "responses": {
          "200": {
