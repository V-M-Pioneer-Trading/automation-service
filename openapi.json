          "shipSymbol",
          "taskKind",
          "phase",
          "waitingUntil",
          "survey",
          "tradeSymbol",
          "marketWaypoint",
          "asteroidWaypoint",
          "failureCount",
          "unrelatedFailureCount",
          "contractId",
          "destinationWaypoint",
          "unitsDelivered",
          "cycleStartedAt",
          "cycleRevenue",
          "cycleTravelDistance",
          "cycleUnitsExtracted",
          "updatedAt"
        ],
