{
  "name": "automation-service",
  "version": "1.0.0",
  "description": "The SpaceTraders fleet autopilot: scores mining, contracts and scouting in credits per hour, drives ships through resumable task loops, calibrates its model from what the fleet has flown, and watches for trouble",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "replay": "npm run build && node dist/replay.js"
  },
  "dependencies": {
    "@v-m-pioneer-trading/clerk-client": "https://github.com/V-M-Pioneer-Trading/clerk-client/releases/download/v2.0.1/v-m-pioneer-trading-clerk-client-2.0.1.tgz",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@v-m-pioneer-trading/eslint-config": "https://github.com/V-M-Pioneer-Trading/eslint-config/releases/download/v1.1.0/v-m-pioneer-trading-eslint-config-1.1.0.tgz",
    "eslint": "^10.12.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
